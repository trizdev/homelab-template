# Copy this file to .env and fill in your own values.
# Never commit .env — it is gitignored.

# Cloudflare Tunnel token from Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-to-a-long-random-string

# Public hostnames you will attach to the tunnel (placeholders only)
GRAFANA_HOSTNAME=grafana.example.com
PROMETHEUS_HOSTNAME=prometheus.example.com
STATUS_HOSTNAME=status.example.com
